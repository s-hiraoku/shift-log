{
  "name": "@shift-log/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ../../scripts/load-root-env.mjs ./node_modules/tsx/dist/cli.mjs watch src/collector.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ../../scripts/load-root-env.mjs dist/collector.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "demo": "node --import ../../scripts/load-root-env.mjs ./node_modules/tsx/dist/cli.mjs src/collector.ts --demo",
    "collect": "node --import ../../scripts/load-root-env.mjs ./node_modules/tsx/dist/cli.mjs src/collector.ts",
    "menubar": "node --import ../../scripts/load-root-env.mjs ./node_modules/tsx/dist/cli.mjs src/collector.ts",
    "menu": "node --import ../../scripts/load-root-env.mjs ./node_modules/tsx/dist/cli.mjs src/open-menu.ts",
    "credentials": "node --import ../../scripts/load-root-env.mjs ./node_modules/tsx/dist/cli.mjs src/credentials-cli.ts",
    "tray": "cargo run --manifest-path tray/Cargo.toml"
  },
  "dependencies": {
    "@shift-log/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
