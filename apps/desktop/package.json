{
  "name": "@shift-log/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/collector.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/collector.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/collector.ts --demo"
  },
  "dependencies": {
    "@shift-log/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
