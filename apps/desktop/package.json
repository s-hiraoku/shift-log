    "app:build": "tauri build"
  },
  "dependencies": {
    "@shift-log/schema": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
