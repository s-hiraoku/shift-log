{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiftLog",
  "version": "0.1.0",
  "identifier": "com.shiftlog.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @shift-log/web dev",
    "beforeBuildCommand": "pnpm --filter @shift-log/web build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShiftLog",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Permission-based activity memory for cloud agents.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMUVCOUUxOTJBRUVDQzQKUldURTdLNlM0YmtlNDNxWVlTNXdxdmUzU0hhcll5dk9LMER1UVU0cjE3eVlUc1FBeCtqaFU5TTQK",
      "endpoints": [
        "https://github.com/s-hiraoku/shift-log/releases/latest/download/latest.json"
      ]
    }
  }
}
