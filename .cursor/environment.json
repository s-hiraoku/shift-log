{
  "name": "ShiftLog",
  "install": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @shift-log/schema build",
  "terminals": [
    {
      "name": "api",
      "command": "SHIFTLOG_API_TOKEN=dev-token PORT=8787 pnpm --filter @shift-log/api dev"
    },
    {
      "name": "web",
      "command": "SHIFTLOG_API_ORIGIN=http://localhost:8787 SHIFTLOG_API_TOKEN=dev-token pnpm --filter @shift-log/web dev"
    },
    {
      "name": "collector",
      "command": "SHIFTLOG_API_ORIGIN=http://localhost:8787 SHIFTLOG_API_TOKEN=dev-token pnpm --filter @shift-log/desktop dev"
    }
  ],
  "ports": [3000, 8787]
}
