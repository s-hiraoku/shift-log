<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shiftlog.collector</string>
  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>--import</string>
    <string>{{REPO}}/scripts/load-root-env.mjs</string>
    <string>{{REPO}}/apps/desktop/dist/collector.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SHIFTLOG_API_ORIGIN</key>
    <string>http://localhost:8787</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/shiftlog-collector.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/shiftlog-collector.log</string>
</dict>
</plist>
