<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shiftlog.api</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/shift-log</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>pnpm</string>
    <string>--filter</string>
    <string>@shift-log/api</string>
    <string>start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SHIFTLOG_API_TOKEN</key>
    <string>replace-me</string>
    <key>SHIFTLOG_DATA_DIR</key>
    <string>/Users/YOU/.local/share/shiftlog</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/shiftlog-api.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/shiftlog-api.log</string>
</dict>
</plist>
