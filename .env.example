# Shared API bearer token (server-side only — never NEXT_PUBLIC_*)
SHIFTLOG_API_TOKEN=dev-token

# API origin used by the web BFF proxy and desktop collector
SHIFTLOG_API_ORIGIN=http://localhost:8787

# Persist memories/windows/permissions under this directory (API server)
SHIFTLOG_DATA_DIR=./data

# Optional: disable file persistence (tests set VITEST automatically)
# SHIFTLOG_PERSIST=0

# Desktop collector demo mode
# SHIFTLOG_DEMO=1
# SHIFTLOG_DEMO_TICK_MS=15000
# SHIFTLOG_FLUSH_MS=60000
