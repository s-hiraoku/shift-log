# Required (fail-closed). Server-side only — never NEXT_PUBLIC_*
SHIFTLOG_API_TOKEN=dev-token

# Multi-user (takes precedence per-token; SHIFTLOG_API_TOKEN still maps to user "default")
# SHIFTLOG_API_TOKENS=alice:alice-secret,bob:bob-secret

# Local demos only — allows implicit Bearer dev-token if no tokens are set
# SHIFTLOG_ALLOW_INSECURE_DEV=1

# API origin used by the web BFF proxy and desktop collector
SHIFTLOG_API_ORIGIN=http://localhost:8787

# SQLite persistence directory (default ./data → data/shiftlog.db)
SHIFTLOG_DATA_DIR=./data

# Postgres / Neon (required on Vercel; when set, used instead of SQLite)
# DATABASE_URL=postgresql://user:pass@host/shiftlog

# Optional CORS allowlist (comma-separated). Default: *
# SHIFTLOG_CORS_ORIGINS=http://localhost:3000

# Optional: disable persistence (tests set VITEST automatically)
# SHIFTLOG_PERSIST=0

# Vercel hourly purge of raw windows older than 48h
# CRON_SECRET=replace-with-long-random

# Upload / abuse controls
# SHIFTLOG_RATE_LIMIT_PER_MIN=60
# SHIFTLOG_MAX_UPLOAD_BYTES=512000

# Optional LLM 10-minute summaries (unset = deterministic template)
# SHIFTLOG_LLM_API_KEY=
# SHIFTLOG_LLM_BASE_URL=https://api.openai.com/v1
# SHIFTLOG_LLM_MODEL=gpt-4o-mini

# Desktop collector
# SHIFTLOG_DEMO=1
# SHIFTLOG_TICK_MS=5000
# SHIFTLOG_FLUSH_MS=600000
# SHIFTLOG_ONCE=1
# SHIFTLOG_CONTROL_PORT=8791
# SHIFTLOG_UI_URL=http://localhost:3000/timeline
# SHIFTLOG_CREDENTIALS_DIR=   # override ~/.config/shiftlog for tests
